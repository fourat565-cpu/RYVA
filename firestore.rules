rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerifiedUser() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      function isValidUser(data) {
        return data.email is string && data.email.size() <= 100 &&
               data.displayName is string && data.displayName.size() <= 50;
      }

      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        !incoming().keys().hasAny(['role', 'isAdmin']) || incoming().role == 'user'
      );
      
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'wishlist', 'savedAddresses'])
      );
    }

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      allow read: if true; // Public catalog
      
      function isValidProduct(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.price is number && data.price > 0 &&
               data.category is string && data.category.size() <= 50;
      }

      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      function isValidOrder(data) {
        return data.userId == request.auth.uid &&
               data.items is list && data.items.size() > 0 &&
               data.total is number && data.total > 0 &&
               data.status in ['pending', 'processing', 'shipped', 'delivered'] &&
               data.createdAt == request.time;
      }

      allow create: if isVerifiedUser() && isValidOrder(incoming());
      
      allow update: if isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        existing().status != 'delivered'
      );
    }

    // --- ADMINS COLLECTION (Identity Source of Truth) ---
    match /admins/{adminId} {
      allow read: if isSignedIn(); // Allow checking for admin state
      allow write: if false; // System-level only
    }
  }
}
